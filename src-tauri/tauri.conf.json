{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maku",
  "version": "0.26.3",
  "identifier": "io.github.yanutros.plexr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Maku",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/offline/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Client Plex et Jellyfin",
    "longDescription": "Client Plex et Jellyfin écrit en Rust : films, séries et musique lus avec mpv, demandes Seerr et statistiques Tracearr intégrées.",
    "publisher": "Maku",
    "copyright": "Maku — GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "mpv"
        ]
      },
      "rpm": {
        "depends": [
          "mpv",
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
